# Eunomia server settings. Copy to .env, fill in the values, keep .env out of git.
# The names and the defaults are in the design, section 6. Empty means not set.

# Secret for the session cookies. 32 or more characters. The server does not start without it.
EUNOMIA_SECRET=
# Data folder (default ./data). In the container: the bind-mounted folder, owned by the container user.
EUNOMIA_DATA=
# Model calls for each code and day (default 200).
EUNOMIA_DAILY_LIMIT=
# Days after which a draft that nobody opened is deleted (default 365).
EUNOMIA_DRAFT_RETENTION_DAYS=

# IAedu. The base URL has a default: https://api.iaedu.pt/agent-chat/api/v1
IAEDU_BASE_URL=
# Shared mode: the GPT-4o agent.
IAEDU_API_KEY=
IAEDU_AGENT_ID=
IAEDU_CHANNEL_ID=
# Alternative model (AMALIA), chosen with ?modelo=amalia.
IAEDU_ALT_API_KEY=
IAEDU_ALT_AGENT_ID=
IAEDU_ALT_CHANNEL_ID=

# GitHub: commits of approved fichas to the library.
GITHUB_TOKEN=
# Default tiagojct/fmup-ia
GITHUB_REPO=
# Default main
GITHUB_BRANCH=
COMMIT_NAME=
COMMIT_EMAIL=
